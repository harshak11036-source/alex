# Database (PostgreSQL is required by the current Prisma schema)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/alex?schema=public"
AUTH_MODE="local"
NEXT_PUBLIC_AUTH_MODE="local"
AI_MODE="mock"
# NVIDIA_NEMOTRON_API_KEY="nvapi-..."
# NVIDIA_NEMOTRON_MODEL="nvidia/nemotron-3-ultra"

# Firebase (Client)
NEXT_PUBLIC_FIREBASE_API_KEY="your-firebase-api-key"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-project-id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-project.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="your-sender-id"
NEXT_PUBLIC_FIREBASE_APP_ID="your-app-id"

# Firebase (Admin - for server-side)
FIREBASE_PROJECT_ID="your-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk@your-project.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-nextauth-secret-key-min-32-chars"
NEXTAUTH_URL="http://localhost:3000"

# Encryption
ENCRYPTION_KEY="your-32-character-encryption-key"

# AI Providers (configure as needed)
# OPENAI_API_KEY="sk-..."
# GOOGLE_GEMINI_API_KEY="..."
# ANTHROPIC_API_KEY="..."
# MISTRAL_API_KEY="..."
# GROQ_API_KEY="..."
# OPENROUTER_API_KEY="..."
# TOGETHER_AI_API_KEY="..."

# Storage
STORAGE_BUCKET_DOCUMENTS="documents"
STORAGE_BUCKET_AVATARS="avatars"
STORAGE_BUCKET_RESOURCES="resources"
STORAGE_MODE="local"

# Email (configure provider)
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_USER="..."
# SMTP_PASSWORD="..."
# EMAIL_FROM="noreply@alex.edu"

# Background Jobs
# REDIS_URL="redis://localhost:6379"

# File Processing
MAX_FILE_SIZE_MB="50"
ALLOWED_FILE_TYPES="pdf,doc,docx,txt,md,csv,xls,xlsx,ppt,pptx,png,jpg,jpeg"

# OCR (optional)
# TESSERACT_PATH="/usr/bin/tesseract"