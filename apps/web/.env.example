# ALEX Web App Environment Variables
# Copy to .env.local and fill in your values

# =============================================================================
# APPLICATION
# =============================================================================
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-min-32-chars

# =============================================================================
# DATABASE (Prisma + PostgreSQL - Neon recommended)
# =============================================================================
# Get from Neon Dashboard: https://console.neon.tech
# Format: postgresql://user:password@ep-xxx.region.neon.tech/dbname?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/alex?schema=public"

# Direct URL for migrations (optional, but recommended for Neon)
# Format: postgresql://user:password@ep-xxx.region.neon.tech/dbname?sslmode=require
DIRECT_URL=""

# =============================================================================
# AUTHENTICATION
# =============================================================================
# Set to "local" for cookie-based auth (no Firebase required)
AUTH_MODE=local
NEXT_PUBLIC_AUTH_MODE=local

# =============================================================================
# ENCRYPTION (Required for AI credential storage)
# =============================================================================
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=your-32-character-encryption-key

# =============================================================================
# AI PROVIDERS (Server-side only - NEVER expose to client)
# Configure at least one for AI features
# =============================================================================
# NVIDIA Nemotron (Primary)
# NVIDIA_NEMOTRON_API_KEY=nvapi-...
# NVIDIA_NEMOTRON_MODEL=nvidia/nemotron-3-ultra
# NVIDIA_NEMOTRON_BASE_URL=https://integrate.api.nvidia.com/v1

# OpenAI
# OPENAI_API_KEY=sk-...

# Google Gemini
# GOOGLE_GEMINI_API_KEY=...

# Anthropic
# ANTHROPIC_API_KEY=...

# Mistral
# MISTRAL_API_KEY=...

# Groq
# GROQ_API_KEY=...

# OpenRouter
# OPENROUTER_API_KEY=...

# Together AI
# TOGETHER_AI_API_KEY=...

# =============================================================================
# STORAGE
# =============================================================================
STORAGE_MODE=local
STORAGE_BUCKET_DOCUMENTS=documents
STORAGE_BUCKET_AVATARS=avatars
STORAGE_BUCKET_RESOURCES=resources
MAX_FILE_SIZE_MB=50
ALLOWED_FILE_TYPES=pdf,doc,docx,txt,md,csv,xls,xlsx,ppt,pptx,png,jpg,jpeg

# =============================================================================
# EMAIL (Optional - for notifications)
# =============================================================================
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=...
# SMTP_PASSWORD=...
# EMAIL_FROM=noreply@alex.edu

# =============================================================================
# BACKGROUND JOBS (Optional - for document processing queue)
# =============================================================================
# REDIS_URL=redis://localhost:6379

# =============================================================================
# FILE PROCESSING (Optional)
# =============================================================================
# TESSERACT_PATH=/usr/bin/tesseract

# =============================================================================
# AI MODE (mock for testing without API keys)
# =============================================================================
AI_MODE=mock